#chatbot has frontend(tkinter)

#important imports : here used tkinter,scrolltextbar,and genai 
import tkinter as tk
from tkinter import scrolledtext
from google import genai

#secret api key
client=genai.Client(api_key="AQ.Ab8RN6IbCWyoXF-rl-iwYKg4EvHMfLIxe05ezy7UV43prYNO7w")
Model_name="gemini-3.1-flash-lite"

#function to ask question with chatbot
def ask_ai():


    question=entry.get()

    if question.strip()=="": #spaces handling
        return
    chatbox.insert(tk.END,"You (User): "+question+"\n\n")
#for exception handling
    try:
        resp=client.models.generate_content(model=Model_name,contents=question)
        answer=resp.text
        chatbox.insert(tk.END,'AI: \n'+answer+'\n\n')
    except Exception as e:
        print(f"Error: {e}")

        chatbox.insert(tk.END,'Error: \n'+str(e)+'\n\n')
        chatbox.insert(tk.END,'-'*60+'\n\n')
        entry.delete(0,tk.END)

#tkinter part
root=tk.Tk()
root.title("Smart API chatbot by SREE")
root.geometry("750x550")
root.configure(bg="pink")

title=tk.Label(root,text="Smart API based Chatbot",font=("Arial",20,"italic"),bg="purple",fg="aqua")
title.pack(pady=10)

entry=tk.Entry(root,font=("Arial",16))
entry.pack(pady=10)

ask_btn=tk.Button(root,text="Ask me",font=("Arial",18,"bold"),bg="blue",fg="white",command=ask_ai)
ask_btn.pack(pady=10)

chatbox=scrolledtext.ScrolledText(root,font=("Times New Roman",15),width=78,height=25)
chatbox.pack(pady=10)
#main loop
root.mainloop()
